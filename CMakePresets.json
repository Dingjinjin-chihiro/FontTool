{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FONTTOOL_BUILD_CLI": "ON",
        "FONTTOOL_BUILD_EXAMPLES": "ON",
        "FONTTOOL_BUILD_TESTS": "ON",
        "FONTTOOL_INSTALL": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug static library",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release static library",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "shared-release",
      "inherits": "base",
      "displayName": "Release shared library",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "shared-release", "configurePreset": "shared-release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "shared-release",
      "configurePreset": "shared-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
